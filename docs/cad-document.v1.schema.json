{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CADDocument v1",
  "type": "object",
  "required": ["schema_version", "file", "layouts", "entities"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "file": {
      "type": "object",
      "required": ["path", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"enum": ["DWG", "DXF"]},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "dxf_version": {"type": "string"}
      }
    },
    "layouts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "layers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "block_definitions": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "block_references": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "dimensions": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "annotations": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "tables": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "views": {"type": "array", "items": {"$ref": "#/$defs/view"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}}
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[a-fA-F0-9]+$"},
    "source": {
      "type": "object",
      "required": ["file", "handle", "layout", "nested_path"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "handle": {"$ref": "#/$defs/handle"},
        "layout": {"type": ["string", "null"]},
        "nested_path": {"type": "array", "items": {"type": "string", "pattern": "^[a-fA-F0-9]+(\\[[0-9]+\\])?$"}},
        "instance_id": {"type": "string", "minLength": 1}
      }
    },
    "observation": {
      "type": "object",
      "required": ["kind", "extraction_method", "validation_status"],
      "properties": {
        "kind": {"enum": ["source_fact", "computed", "inferred"]},
        "extraction_method": {"type": "string", "minLength": 1},
        "validation_status": {"enum": ["validated", "unverified", "partial", "unavailable"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "if": {"required": ["confidence"]},
      "then": {"properties": {"kind": {"const": "inferred"}}}
    },
    "entity": {
      "allOf": [{"$ref": "#/$defs/observation"}],
      "type": "object",
      "required": ["source", "entity_type", "layer", "coordinate_system", "data"],
      "properties": {
        "source": {"$ref": "#/$defs/source"},
        "entity_type": {"type": "string", "minLength": 1},
        "layer": {"type": ["string", "null"]},
        "coordinate_system": {"enum": ["WCS", "UCS", "OCS", "block_local", "unknown"]},
        "data": {"type": "object"},
        "measurement": {"type": ["number", "null"]},
        "display_text": {"type": ["string", "null"]}
      }
    },
    "view": {
      "allOf": [{"$ref": "#/$defs/observation"}],
      "type": "object",
      "required": ["id", "view_type", "members"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "view_type": {"enum": ["plan", "elevation", "section", "unknown"]},
        "members": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/source"}], "properties": {
          "relation": {"enum": ["contained", "crosses_boundary"]}, "ambiguous": {"type": "boolean"}
        }}},
        "frame": {"$ref": "#/$defs/source"},
        "bbox_min": {"$ref": "#/$defs/xy"},
        "bbox_max": {"$ref": "#/$defs/xy"},
        "titles": {"type": "array", "items": {"type": "object", "required": ["source", "text", "view_type"], "properties": {
          "source": {"$ref": "#/$defs/source"}, "text": {"type": "string"},
          "view_type": {"enum": ["plan", "elevation", "section"]}
        }}},
        "ambiguous": {"type": "boolean"},
        "frame_evidence": {"enum": ["named_frame_reference", "explicit_frame_layer"]},
        "classification_ambiguous": {"type": "boolean"},
        "boundary_ambiguous": {"type": "boolean"}
      }
    },
    "xy": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "relationship": {
      "allOf": [{"$ref": "#/$defs/observation"}],
      "type": "object",
      "required": ["from", "to", "relationship_type"],
      "properties": {
        "from": {"$ref": "#/$defs/source"},
        "to": {"$ref": "#/$defs/source"},
        "relationship_type": {"type": "string", "minLength": 1}
      }
    }
  }
}
